FROM node:22-bookworm-slim AS node-runtime
FROM ubuntu:24.04
ARG BLENDER_VERSION=4.5.17
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils python3 python3-pil ffmpeg libx11-6 libxi6 libxxf86vm1 libxfixes3 \
    libxrender1 libsm6 libice6 libgl1 libegl1 libgomp1 libxkbcommon0 \
    libwayland-client0 libwayland-cursor0 libwayland-egl1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    archive="blender-${BLENDER_VERSION}-linux-x64.tar.xz"; \
    url="https://mirror.blender.org/release/Blender4.5"; \
    cd /tmp; \
    curl -fSL --retry 2 --connect-timeout 20 --max-time 600 -o "$archive" "$url/$archive"; \
    curl -fSL --retry 2 --connect-timeout 20 --max-time 60 -o "blender-${BLENDER_VERSION}.sha256" "$url/blender-${BLENDER_VERSION}.sha256"; \
    awk -v name="$archive" '$2 == name || $2 == "*" name {print}' "blender-${BLENDER_VERSION}.sha256" > archive.sha256; \
    test -s archive.sha256; sha256sum -c archive.sha256; \
    mkdir -p /opt/blender; tar -xJf "$archive" --strip-components=1 -C /opt/blender; \
    rm "$archive" archive.sha256 "blender-${BLENDER_VERSION}.sha256"
ENV BLENDER_BIN=/opt/blender/blender
ENV HOME=/tmp
WORKDIR /work


COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN groupadd --gid 10001 studio && useradd --uid 10001 --gid 10001 --no-create-home studio \
    && mkdir -p /opt/studio && chown 10001:10001 /opt/studio
WORKDIR /opt/studio
COPY --chown=10001:10001 engine/brand/ ./engine/brand/
COPY --chown=10001:10001 engine/motion/gold_light_v02.py engine/motion/gold_light_clip.py engine/motion/gold_light_post.py engine/motion/gold_light_assemble.py engine/motion/gold_light_v03.py engine/motion/gold_light_v03_post.py engine/motion/gold_light_v04.py engine/motion/gold_light_v05.py engine/motion/gold_light_v05_post.py ./engine/motion/
COPY --chown=10001:10001 plugins/blender/review-contract.mjs plugins/blender/review-runner.mjs plugins/blender/clip-plan.mjs plugins/blender/clip-batch-runner.mjs ./plugins/blender/
COPY --chown=10001:10001 scripts/gpu_batch_transfer.py /opt/studio/scripts/gpu_batch_transfer.py
USER 10001:10001
RUN node --version && /opt/blender/blender --version && ffmpeg -version && ffprobe -version && python3 -c "import PIL"
RUN /opt/blender/blender --background --factory-startup --disable-autoexec --python-exit-code 1 --threads 4 --python-expr 'import sys; sys.path.insert(0,"/opt/studio/engine/motion"); from gold_light_v04 import create_scene; names=["silver-monogram","gold-r","silver-wordmark","gold-descriptor"]; boxes=[(270,160,690,410),(710,160,1000,410),(340,480,950,530),(320,600,960,640)]; g={"groups":[{"name":n,"loops":[[[x,y],[X,y],[X,Y],[x,Y]]]} for n,(x,y,X,Y) in zip(names,boxes)]}; s,b=create_scene(g,"synthetic-api-smoke"); s.frame_set(78); print("V04_SCENE_API_SMOKE_PASS")'
RUN /opt/blender/blender --background --factory-startup --disable-autoexec --python-exit-code 1 --threads 4 --python-expr 'import sys; sys.path.insert(0,"/opt/studio/engine/motion"); from gold_light_v05 import create_scene; names=["silver-monogram","gold-r","silver-wordmark","gold-descriptor"]; boxes=[(270,160,690,410),(710,160,1000,410),(340,480,950,530),(320,600,960,640)]; g={"groups":[{"name":n,"loops":[[[x,y],[X,y],[X,Y],[x,Y]]]} for n,(x,y,X,Y) in zip(names,boxes)]}; s,geom,pos=create_scene(g,"synthetic-api-smoke"); s.frame_set(78); assert len(pos)==120; assert geom["topologyPreserved"]; s.render.resolution_x=96; s.render.resolution_y=54; s.cycles.samples=1; bpy=__import__("bpy"); bpy.ops.render.render(); print("V05_NATIVE_RENDER_SMOKE_PASS")'
# The DO starts this idle entrypoint only after an explicit one-shot request.
ENTRYPOINT ["/bin/sleep", "infinity"]
