{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grp-studios",
  "main": "review-worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "STUDIO_RENDER_ENABLED": "false",
    "STUDIO_QUEUE_RENDER_ENABLED": "true"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "grp-studios-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEW_RENDERER",
        "class_name": "GoldLightRenderer"
      },
      {
        "name": "ON_DEMAND_RENDERER",
        "class_name": "OnDemandGoldLightRenderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "review-v1",
      "new_sqlite_classes": [
        "GoldLightRenderer"
      ]
    },
    {
      "tag": "review-v2-on-demand",
      "new_sqlite_classes": [
        "OnDemandGoldLightRenderer"
      ]
    }
  ],
  "containers": [
    {
      "name": "grp-studios-render-on-demand",
      "class_name": "OnDemandGoldLightRenderer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/4503c227327d5bf330cad259bf0b758e/grp-studios-render-worker@sha256:395c73946a0cbb29eef5997634d9642949565c5e58ab4a2b1574f54aa24452c4"
        }
      },
      "ssh": {
        "enabled": false
      },
      "observability": {
        "logs": {
          "enabled": true
        }
      }
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "grp-studios-render-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 0,
        "max_concurrency": 1,
        "dead_letter_queue": "grp-studios-render-dlq"
      }
    ]
  }
}
